<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DelDia" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorOnPrimary">@color/primary_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/secondary_text</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/nexa_light</item>
        <item name="materialButtonStyle">@style/ButtonStyle</item>
        <item name="android:textColor">@color/primary_text</item>

    </style>

    <style name="NexaTextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/nexa_light</item>
    </style>


    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/blue_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">50dp</item>
        <item name="iconTint">@color/icons</item>
    </style>

    <style name="datePickerTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryDark">@color/purple_500</item>
        <item name="colorAccent">@color/purple_700</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/datePickerTheme.ButtonBarNegativeButtonStyle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/datePickerTheme.ButtonBarPositiveButtonStyle</item>
    </style>
    <style name="datePickerTheme.ButtonBarNegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/purple_500</item>
    </style>
    <style name="datePickerTheme.ButtonBarPositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/purple_700</item>
    </style>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/accent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppSearchView" parent="Widget.AppCompat.SearchView" >
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nexa_light</item>
    </style>

    <style name="BottomNavigation">
        <item name="android:background">@color/primary</item>
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextColor">@color/white</item>
    </style>

    <style name="CustomTextInputLayoutFilledBoxStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/primary_text</item>
        <item name="android:textColorHint">@color/primary_text</item>
        <item name="hintTextColor">@color/primary_text</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="startIconTint">@color/primary_text</item>
        <item name="endIconTint">@color/primary_text</item>
    </style>

    <style name="SpinnerStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <!-- Color of box ONLY, not dropdown -->
        <item name="boxBackgroundColor">@color/white</item>
        <!-- Box outline color depending on state (default, enabled, but NOT error) -->
        <item name="boxStrokeColor">@color/purple_200</item>
        <!-- Box outline color just for errors -->
        <item name="boxStrokeErrorColor">@color/red_light</item>
        <!-- Enable 8dp space below the box for error message -->
<!--        <item name="errorEnabled">true</item>-->
        <!-- Hint INSIDE the box, before focusing the TextInputEditText -->
        <item name="android:textColorHint">@color/black</item>
        <!-- Hint ON TOP of the box, when the spinner's TextInputEditText is focused. -->
        <item name="hintTextColor">@color/black</item>

    </style>

    <style name="CustomSwitchStyle" parent="@style/Widget.AppCompat.CompoundButton.Switch">
        <item name="android:colorControlActivated">#b71c1c</item>
    </style>

    <style name="CustomCardViewStyle" parent="CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:layout_margin">10dp</item>
    </style>

    <!-- Estilos específicos para login -->
    <style name="LoginTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/login_input_stroke</item>
        <item name="android:textColorHint">@color/login_hint_text</item>
        <item name="hintTextColor">@color/login_hint_text</item>
        <item name="boxBackgroundColor">@color/login_input_background</item>
        <item name="startIconTint">@color/login_hint_text</item>
        <item name="endIconTint">@color/login_hint_text</item>
    </style>

    <style name="LoginButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/login_button_background</item>
        <item name="android:textColor">@color/login_button_text</item>
        <item name="cornerRadius">50dp</item>
        <item name="iconTint">@color/login_button_text</item>
    </style>

    <!-- Estilos específicos para navegación -->
    <style name="DrawerLayoutStyle">
        <item name="android:background">@color/navigation_background</item>
    </style>

    <style name="NavigationViewStyle" parent="Widget.MaterialComponents.NavigationView">
        <item name="android:background">@color/navigation_drawer_background</item>
        <item name="itemIconTint">@color/navigation_drawer_text</item>
        <item name="itemTextColor">@color/navigation_drawer_text</item>
        <item name="itemTextAppearance">@style/NexaTextViewStyle</item>
    </style>

    <style name="BottomNavigationStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bottom_navigation_background</item>
        <item name="itemIconTint">@color/bottom_navigation_text</item>
        <item name="itemTextColor">@color/bottom_navigation_text</item>
    </style>

    <style name="ToolbarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/toolbar_background</item>
        <item name="android:titleTextColor">@color/toolbar_text</item>
        <item name="android:textColorPrimary">@color/toolbar_text</item>
    </style>

    <!-- Estilo para diálogo de pantalla completa -->
    <style name="FullScreenDialogStyle" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- Estilo para AutoCompleteTextView como Spinner -->
    <style name="AutoCompleteSpinnerStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColor">@color/autocomplete_text</item>
        <item name="android:textColorHint">@color/autocomplete_hint</item>
        <item name="android:background">@drawable/autocomplete_background_pressed</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nexa_light</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:completionThreshold">1</item>
    </style>

    <!-- Estilos específicos para CollectionSheet en modo light -->
    <style name="CollectionSheetTitleStyle">
        <item name="android:textColor">@color/collection_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CollectionSheetSubtitleStyle">
        <item name="android:textColor">@color/collection_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nexa_light</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CollectionSheetCardStyle">
        <item name="android:background">@color/collection_card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="CollectionSheetInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/collection_text_hint</item>
        <item name="android:background">@color/collection_input_background</item>
        <item name="boxStrokeColor">@color/collection_input_stroke</item>
        <item name="hintTextColor">@color/collection_text_hint</item>
    </style>

    <style name="CollectionSheetButtonStyle">
        <item name="android:backgroundTint">@color/collection_button_background</item>
        <item name="android:textColor">@color/collection_button_text</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nobile</item>
    </style>

    <style name="CollectionSheetTotalsCardStyle">
        <item name="android:background">@color/collection_totals_card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <style name="CollectionSheetTotalsTitleStyle">
        <item name="android:textColor">@color/collection_totals_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CollectionSheetTotalsLabelStyle">
        <item name="android:textColor">@color/collection_totals_label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
    </style>

    <style name="CollectionSheetTotalsValueStyle">
        <item name="android:textColor">@color/collection_totals_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
    </style>

    <!-- Estilos para diálogos -->
    <style name="DialogTitleStyle">
        <item name="android:textColor">@color/dialog_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
    </style>

    <style name="DialogSubtitleStyle">
        <item name="android:textColor">@color/dialog_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nexa_light</item>
    </style>

    <style name="DialogCardStyle">
        <item name="android:background">@color/dialog_card_background</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="DialogInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/dialog_text_hint</item>
        <item name="android:background">@color/dialog_input_background</item>
        <item name="boxStrokeColor">@color/dialog_input_stroke</item>
        <item name="hintTextColor">@color/dialog_text_hint</item>
    </style>

    <style name="DialogButtonStyle">
        <item name="android:backgroundTint">@color/dialog_button_background</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nobile</item>
    </style>

    <style name="DialogButtonOutlinedStyle">
        <item name="android:textColor">@color/dialog_button_outline</item>
        <item name="strokeColor">@color/dialog_button_outline</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nobile</item>
    </style>

    <style name="DialogSuccessButtonStyle">
        <item name="android:backgroundTint">@color/dialog_success_button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nobile</item>
    </style>

    <style name="DialogLoadingCardStyle">
        <item name="android:background">@color/dialog_loading_card</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="DialogLoadingTextStyle">
        <item name="android:textColor">@color/dialog_loading_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/nexa_bold</item>
    </style>

    <style name="DialogLoadingSubtextStyle">
        <item name="android:textColor">@color/dialog_loading_subtext</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/nexa_light</item>
    </style>

</resources>