<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkBoxGang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewGangName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUTA 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/collection_text_primary" />

        <TextView
            android:id="@+id/textViewWarehouseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autoventa 1 = BFG-712 Grande"
            android:textSize="14sp"
            android:textColor="@color/collection_text_secondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
