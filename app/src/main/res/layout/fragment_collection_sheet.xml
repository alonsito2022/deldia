<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigation_background"
    android:fillViewport="true"
    tools:context=".fragments.CollectionSheetFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        <TextView
            android:id="@+id/textViewTitleCollectionSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hoja de Cobranza"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/nexa_bold"
            android:textColor="@color/login_text_primary"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Consulta tu cobranza por fecha"
            android:textSize="14sp"
            android:fontFamily="@font/nexa_light"
            android:textColor="@color/login_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/textViewTitleCollectionSheet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- Card para los campos de entrada -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/login_card_background"
            app:layout_constraintTop_toBottomOf="@id/textViewSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vendedor"
                    style="@style/LoginTextInputLayoutStyle"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:fontFamily="@font/nexa_light"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSearchDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Fecha de consulta"
                    style="@style/LoginTextInputLayoutStyle"
                    app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextSearchDate"
                android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:inputType="date"
                        android:textSize="16sp"
                        android:fontFamily="@font/nexa_light" />
        </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="56dp"
            style="@style/LoginButtonStyle"
            android:text="CONSULTAR COBROS"
            android:textSize="16sp"
            android:fontFamily="@font/nobile"
            android:layout_marginTop="24dp"
            app:icon="@drawable/ic_baseline_search_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@+id/textInputLayoutSearchDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sección de Totalizadores -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewTotals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/login_card_background"
            app:layout_constraintTop_toBottomOf="@+id/btnSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE VENTAS"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/nexa_bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/login_text_primary" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center"
                    android:background="@color/primary"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_primary"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="COMPRADO:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalPurchased"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_secondary"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CRÉDITO:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_warning"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YAPE:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalYape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_black"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DEVUELTO:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalReturned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_black"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EFECTIVO:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_black"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PENDIENTE:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/textViewTotalPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nexa_bold"
                        android:textColor="@color/white" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>