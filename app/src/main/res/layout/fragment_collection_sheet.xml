<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collection_background"
    android:fillViewport="true"
    tools:context=".fragments.CollectionSheetFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        <TextView
            android:id="@+id/textViewTitleCollectionSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hoja de Cobranza"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="16dp"
            style="@style/CollectionSheetTitleStyle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Consulta tu cobranza por fecha"
            android:layout_marginBottom="24dp"
            style="@style/CollectionSheetSubtitleStyle"
            app:layout_constraintTop_toBottomOf="@id/textViewTitleCollectionSheet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <!-- Card para los campos de entrada -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewInputs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/CollectionSheetCardStyle"
            app:layout_constraintTop_toBottomOf="@id/textViewSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Campo editable para administradores -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vendedor"
                    style="@style/CollectionSheetInputLayoutStyle"
                    android:layout_marginBottom="16dp">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteUser"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textPersonName"
                        style="@style/AutoCompleteSpinnerStyle"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo de solo lectura para preventistas/repartidores -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutUserReadOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Vendedor"
                    style="@style/CollectionSheetInputLayoutStyle"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextUserFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:enabled="false"
                        android:textSize="16sp"
                        android:fontFamily="@font/nexa_light"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Multiselector de rutas para REPARTIDOR -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewGangMultiSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    style="@style/CollectionSheetCardStyle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seleccionar Rutas"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/collection_text_primary"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecciona las rutas para consultar su cobranza"
                            android:textSize="14sp"
                            android:textColor="@color/collection_text_secondary"
                            android:layout_marginBottom="12dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewGangMultiSelect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="200dp"
                            android:scrollbars="vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSearchDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Fecha de consulta"
                    style="@style/CollectionSheetInputLayoutStyle"
                    app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextSearchDate"
                android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:inputType="date"
                        android:textSize="16sp"
                        android:fontFamily="@font/nexa_light" />
        </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <Button
            android:id="@+id/btnSearch"
            android:layout_width="0dp"
            android:layout_height="56dp"
            style="@style/CollectionSheetButtonStyle"
            android:text="CONSULTAR COBROS"
            android:layout_marginTop="24dp"
            app:icon="@drawable/ic_baseline_search_24"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:layout_constraintTop_toBottomOf="@+id/cardViewInputs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sección de Totalizadores -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewTotals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            style="@style/CollectionSheetTotalsCardStyle"
            app:layout_constraintTop_toBottomOf="@+id/btnSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESUMEN DE VENTAS"
                    android:layout_marginBottom="8dp"
                    style="@style/CollectionSheetTotalsTitleStyle" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_gravity="center"
                    android:background="@color/primary"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="COMPRADO:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalPurchased"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CRÉDITO:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YAPE:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalYape"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DEVUELTO:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalReturned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EFECTIVO:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/round_totals_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PENDIENTE:"
                        style="@style/CollectionSheetTotalsLabelStyle" />

                    <TextView
                        android:id="@+id/textViewTotalPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/CollectionSheetTotalsValueStyle" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>